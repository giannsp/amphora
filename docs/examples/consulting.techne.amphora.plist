<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Managed preferences for Amphora.
  Jamf Pro: Configuration Profiles → Application & Custom Settings → Upload,
  preference domain consulting.techne.amphora. Remove the keys you don't want to enforce.
  The Jamf API client secret is never set here: enter it once in the app (it stays in the Keychain).
-->
<plist version="1.0">
<dict>
    <key>ModelSource</key>
    <string>jamf</string>
    <key>JamfURL</key>
    <string>https://yourorg.jamfcloud.com</string>
    <key>JamfClientID</key>
    <string>00000000-0000-0000-0000-000000000000</string>
    <key>JamfManagedDevicesOnly</key>
    <true/>
    <key>JamfRemovedModelGraceDays</key>
    <integer>14</integer>
    <key>StorePath</key>
    <string>/Users/Shared/Amphora</string>
    <key>PruneOldIPSWs</key>
    <true/>
    <key>ExportToConfigurator</key>
    <true/>
    <key>SyncIntervalHours</key>
    <integer>6</integer>
    <key>ShowInMenuBar</key>
    <true/>
</dict>
</plist>
